{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "container-vpc-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],

  "containers": [
    {
      "class_name": "MyContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "name": "container-vpc-demo"
    }
  ],

  "durable_objects": {
    "bindings": [
      { "class_name": "MyContainer", "name": "MY_CONTAINER" }
    ]
  },

  "migrations": [
    { "new_sqlite_classes": ["MyContainer"], "tag": "v1" }
  ],

  "vpc_services": [
    {
      "binding": "PRIVATE_API",
      "service_id": "019dbc57-f657-7023-9b23-71c2646ecffa",
      "remote": true
    },
    {
      "binding": "SLOW_VPC",
      "service_id": "019e6576-429d-7802-84fa-0bb4269d6c5b",
      "remote": true
    },
    {
      // -> slow-via-mac VPC service -> cloudflared on this Mac -> 127.0.0.1:9000
      "binding": "MAC_VPC",
      "service_id": "019e65a4-38a3-73f3-930c-c6329ea3d328",
      "remote": true
    }
  ],

  // "routes" intentionally omitted: the custom domain vpc-demo.demoflair.com
  // is already wired up. Listing it here forces wrangler to reconcile zone
  // routes (Workers Routes:Read needed) which the current token lacks.
  "workers_dev": true,

  "observability": { "enabled": true }
}
